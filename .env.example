# Copy this file to .env in the project root; restart server.py after editing.
# All settings are optional. Without keys, sample lessons and browser audio work.
# Never put real credentials in this example or browser JavaScript.

# Natural narration: key needs Text to Speech access; voice must allow API use.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional alternate Gemma provider (overrides the default Google adapter):
# full OpenAI-compatible chat completions URL,
# provider key, and exact Gemma model ID. Configure all three together.
GEMMA_API_URL=
GEMMA_API_KEY=
GEMMA_MODEL=

# Default Gemma 4 lessons (free subject to quota) and optional paid Nano Banana 2
# illustrations. Get a Google key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=

# Default image provider: Cloudflare FLUX.1 Schnell. No paid-provider fallback.
IMAGE_PROVIDER=cloudflare
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# To explicitly use paid Nano Banana 2 instead, set IMAGE_PROVIDER=google.
